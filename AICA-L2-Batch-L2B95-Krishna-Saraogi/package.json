{
  "name": "onehr-payroll-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --packages=external",
    "build": "vite build && npm run build:server",
    "start": "node dist/server.mjs",
    "start:prod": "node dist/server.mjs",
    "preview": "vite preview",
    "test": "tsx src/tests/payrollEngine.test.ts",
    "clean": "node -e \"['dist','server.js'].forEach(p=>{try{require('fs').rmSync(p,{recursive:true,force:true})}catch(e){}})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  },
  "description": "Indian payroll and statutory compliance manager (PF, ESIC, PT, TDS) with maker-checker controls and AI-assisted review",
  "engines": {
    "node": ">=20"
  }
}
